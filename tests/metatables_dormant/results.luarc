local Class = {}
Class.__index = Class
function Class.new(x) return setmetatable({x = x}, Class) end
function Class:pair() return self.x, 9 end
function Class:tail(...: number): (number, ...number) return self.x, ... end
local obj = Class.new(7)
print("pair-colon", obj:pair())
print("pair-dot", obj.pair(obj))
local a, b, c = obj:pair()
print("adjust", a, b, c)
print("tail-colon", obj:tail(1, 2))
print("tail-dot", obj.tail(obj, 3, 4))
print("tail-empty", obj:tail())
local function first() print("first") return 2 end
local function last() print("last") return 3, 4 end
function Class:add(a, b) return self.x + a + b end
print("args", obj:add(first(), last()))
