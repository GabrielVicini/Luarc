local Class = {}
Class.__index = Class
function Class.new(x) return setmetatable({x = x}, Class) end
local obj = Class.new(7)
local function old(self, arg) print("old", self.x, arg) return self.x end
local function new(self, arg) print("new", self.x, arg) return self.x + arg end
local function receiver() print("receiver") return obj end
local function argument() print("argument") Class.get = new return 3 end
Class.get = old
print("dot", receiver().get(obj, argument()))
Class.get = old
print("colon", receiver():get(argument()))
Class.get = old
obj.get = old
print("own-colon", receiver():get(argument()))
local function own_argument() print("own-argument") obj.get = new return 3 end
obj.get = old
print("own-replace-colon", receiver():get(own_argument()))
obj.get = nil
local function shadow_argument() print("shadow-argument") obj.get = new return 3 end
Class.get = old
print("shadow-colon", receiver():get(shadow_argument()))
