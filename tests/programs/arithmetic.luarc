-- numbers are f64; Luau floor division / modulo semantics
print(7 / 2, 7 // 2, -7 // 2, 7 % 3, -7 % 3, 7 % -3)
print(2 ^ 10, 2 ^ 0.5, -2 ^ 2)
print(1 / 0, -1 / 0, 0 / 0 ~= 0 / 0)
print(5 % math.huge, -0.0, 0.1 + 0.2)
print(1e20, 1e15, 123456789012, 1.5e-7, 2 ^ 53)
print(10 - 2 - 3, 2 ^ 3 ^ 2, (2 ^ 3) ^ 2)
print(1 + 2 * 3 - 4 / 2, "a" .. "b" .. 1 .. 2)
print(math.floor(-3.5), math.ceil(-3.5), math.abs(-4), math.sqrt(16))
print(math.min(3, 1, 2), math.max(3, 1, 2), math.pi)
local x = 10
x += 5
x -= 3
x *= 2
x /= 4
x //= 1
x %= 4
x ^= 2
print(x)
print(3 == 3.0, 1 < 2, "a" < "b", "abc" < "abd", 2 >= 2)
print(0x10, 0b101, 1_000_000)
