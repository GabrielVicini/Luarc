-- expect-error: 0:0: table narrowing from any requires runtime-table producers; a static table is manually boxed here
local function inspect(boxed: any)
    local trigger = setmetatable({}, {__metatable=false})
    if type(boxed) == "table" then print(boxed.value) end
end
local _, source = pcall(function() return {value=7} end)
