local function f(...: number): number
  return ...
end
local function g(...: number): number
  return math.max(...)
end
local function h(...: number): number
  return select(1, 2, 3)
end
local function pass(...: number) return ... end
local function k(): number
  return math.min(1, pass(2, 3))
end
local function m(...: number): (...number)
  return ...
end
local fixed: (...number) -> number = m
print(f(1), g(1), h(1), k(), fixed())
print(math.max(table.unpack({1, 2})))
