-- Luau Impostor Detector: single-file semantic conformance stress test
-- Intended for a current, full-featured standalone Luau runtime.
-- No Roblox services, filesystem, or third-party libraries required.
-- A compile-time rejection is itself a useful compatibility result.
--!nocheck



local passed = 0
local failed = 0
local failures = {}

local function equal(actual, expected, label)
    if actual ~= expected then
        error(string.format("%s: expected %s, got %s", label or "comparison", tostring(expected), tostring(actual)), 2)
    end
end

local function check(condition, label)
    if not condition then
        error(label or "assertion failed", 2)
    end
end

local function probe(name, fn)
    local ok, err = pcall(fn)
    if ok then
        passed += 1
        print("[PASS] " .. name)
    else
        failed += 1
        table.insert(failures, name .. " -> " .. tostring(err))
        print("[FAIL] " .. name .. " -> " .. tostring(err))
    end
end

probe("03 elseif expression and scope shadowing", function()
    local x = 7
    local function classify(n: number): string
        return if n < 0 then "negative" elseif n == 0 then "zero" else "positive"
    end
    do
        local x = -1
        equal(classify(x), "negative")
    end
    equal(x, 7)
    equal(classify(0), "zero")
    equal(classify(x), "positive")
end)
print(string.format("p03: %d passed, %d failed", passed, failed))
