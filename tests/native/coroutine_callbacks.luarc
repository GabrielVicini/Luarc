local fx = require("rust:fixture")
local co = coroutine.create(function()
    fx.apply_twice(function(x)
        print("synchronous", coroutine.isyieldable())
        coroutine.yield("forbidden")
        return x * 3
    end, 2)
end)
print(coroutine.resume(co))
local bus = fx.Bus.new()
bus:subscribe(function(x)
    print("retained", coroutine.isyieldable())
    coroutine.yield("forbidden")
end)
local other = coroutine.create(function() bus:emit(1) end)
print(coroutine.resume(other))
print(coroutine.status(other))
