-- Luau math library functions and string.reverse.
print(math.fmod(5, 0) ~= math.fmod(5, 0))
print(math.fmod(-7, 3), math.fmod(7, -3), math.fmod(5.5, 2))
print(math.log(8, 2), math.log(100, 10), math.log(1), math.log(27, 3))
print(math.round(2.5), math.round(-2.5), math.round(0.49999999999999994), math.sign(-3), math.sign(0), math.sign(0/0))
print(pcall(function() return math.clamp(5, 3, 1) end))
print(math.clamp(5, 1, 3), math.clamp(-1, 0, 2))
print(math.sin(1), math.cos(1), math.tan(1), math.atan2(1, 2), math.exp(1), math.deg(math.pi), math.rad(180))
print(math.pow(2, 10), math.asin(1), math.acos(0), math.atan(1), math.sinh(1), math.cosh(1), math.tanh(1), math.log10(1000))
print(string.reverse("abc"), ("h\0i"):reverse() == "i\0h", string.reverse(""))
