-- Luau 0.743 bit32 conversion, all functions and errors.
print(bit32.band(),bit32.bor(),bit32.bxor(),bit32.btest())
print(bit32.band("0xff",7),bit32.bor(-1,0),bit32.bxor(1.9,3.5),bit32.bnot(1.9))
print(bit32.lshift(1,31),bit32.rshift(2147483648,31),bit32.arshift(2147483648,40))
print(bit32.lshift(5,math.huge),bit32.rshift(5,0/0),bit32.arshift(2147483648,-2147483648))
print(bit32.lshift(3,-1),bit32.rshift(3,-1),bit32.arshift(2147483648,-1))
print(bit32.lrotate(1,-1),bit32.rrotate(1,1),bit32.lrotate(5,33))
print(bit32.extract(305419896,8,8),bit32.replace(0,255,8,8),bit32.extract(255,0,nil))
print(bit32.countlz(0),bit32.countlz(1),bit32.countrz(0),bit32.countrz(8),bit32.byteswap(305419896))
print(bit32.band(0/0,255),bit32.bor(math.huge,5),bit32.bor(2^63,5))
local function failure(f)
 local ok,err=pcall(f)
 print(ok,err)
end
failure(function()return bit32.bnot()end)
failure(function()return bit32.band(nil)end)
failure(function()return bit32.bxor(false)end)
failure(function()return bit32.band("bad")end)
failure(function()return bit32.extract(0,-1)end)
failure(function()return bit32.extract(0,0,0)end)
failure(function()return bit32.replace(0,0,32)end)
local state=305419896
local checksum=0
for _=1,200 do
 state=(1664525*state+1013904223)%4294967296
 checksum=bit32.bxor(checksum,state)
end
print(state,checksum)
