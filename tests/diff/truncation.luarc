-- Luau 0.743 truncation semantics.
-- string.format %d truncates toward zero; NaN/inf/out-of-range print i64::MIN
print(string.format("%d|%d|%d|%d", 3.7, -3.7, 0.5, -0.5))
print(string.format("%d|%d|%d", 0/0, math.huge, 2^63))
print(string.format("%d|%d", -2^63, 2^53))
-- string.char truncates; out-of-range codes still fail
print(string.char(65.5, 66.9), #string.char(-0.5), string.byte(string.char(255.9)))
print(pcall(function() return string.char(256) end))
print(pcall(function() return string.char(65, -1) end))
-- table.insert / table.remove truncate fractional positions
local t = {"a", "b", "c"}
table.insert(t, 1.5, "x")
table.insert(t, 2.9, "y")
print(table.concat(t, ","))
print(table.remove(t, 1.9), table.concat(t, ","))
-- numeric for: step 0 behaves like a non-positive step (`i >= limit`)
local n = 0
for i = 1, 2, 0 do n += 1 end
print("zero step, start < limit", n)
n = 0
for i = 2, 1, 0 do n += 1 if n >= 4 then break end end
print("zero step, start >= limit", n)
n = 0
local step = 0
for i = 1, 1, step do n += 1 if n >= 3 then break end end
print("dynamic zero step", n)
n = 0
for i = 1, 3, 0/0 do n += 1 end
print("nan step", n)
n = 0
for i = 3, 1, 0/0 do n += 1 if n >= 5 then break end end
print("nan step, start >= limit", n)
n = 0
for i = 1, 0/0 do n += 1 end
print("nan limit", n)
