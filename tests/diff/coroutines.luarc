-- Real stackful suspension: nested frames, loops, varargs, nil, aliases, errors.
local create = coroutine.create
local resume = coroutine.resume
local parent: any = nil
parent = create(function(...)
    print("entry", select("#", ...), ...)
    local child = create(function()
        print("parent", coroutine.status(parent))
        print("parent-resume", resume(parent))
        print("parent-close", pcall(function() coroutine.close(parent) end))
        coroutine.yield("child")
    end)
    print(resume(child))
    print("self", coroutine.status(parent))
    print("self-resume", resume(parent))
    print("self-close", pcall(function() coroutine.close(parent) end))
    local function nested()
        for i = 1, 2 do coroutine.yield("nested", i, nil) end
        return "finished", nil
    end
    return nested()
end)
local function mark(s)
    print("mark", s)
    return s
end
print(type(parent), coroutine.status(parent), coroutine.isyieldable())
print(resume(parent, mark("a"), mark("b"), nil))
print(resume(parent))
print(resume(parent))
print(coroutine.status(parent), resume(parent))
print(coroutine.close(parent))
local wrapped = coroutine.wrap(function(a, ...)
    print("wrapped", a, select("#", ...), ...)
    return coroutine.yield(nil, false)
end)
print(wrapped(3, "x", nil))
print(wrapped("again", nil))
print(pcall(function() wrapped() end))
print(pcall(wrapped))
local function empty() end
print(pcall(function() coroutine.create(empty()) end))
print(pcall(function() coroutine.resume(empty()) end))
print(pcall(function() coroutine.close(nil) end))
print(pcall(function() coroutine.wrap() end))
print(pcall(function() coroutine.status() end))
print(coroutine.isyieldable(mark("ignored")))
local errored = create(function() error("bad", 0) end)
print(resume(errored))
print(coroutine.status(errored))
print(coroutine.close(errored))
print(coroutine.close(errored))
local closed = create(function() coroutine.yield("close") end)
print(resume(closed))
print(coroutine.close(closed), coroutine.status(closed))
local comparison = coroutine.wrap(function()
    table.sort({2, 1}, function(a, b)
        print("sort-yieldable", coroutine.isyieldable())
        coroutine.yield("forbidden")
        return a < b
    end)
end)
print(pcall(comparison))
local replacement = coroutine.wrap(function()
    string.gsub("a", ".", function(s)
        print("gsub-yieldable", coroutine.isyieldable())
        coroutine.yield("forbidden")
        return s
    end)
end)
print(pcall(replacement))
local variadic = coroutine.wrap(function(...)
    return coroutine.yield(...)
end)
print(variadic("vararg", nil, false))
print(variadic(nil, "done"))
local function resume_all(thread: any, ...: any)
    return coroutine.resume(thread, ...)
end
local forwarding = create(function(...) return coroutine.yield(...) end)
print(resume_all(forwarding, "forwarded", nil, false))
print(resume_all(forwarding, nil, "returned"))
local protected = create(function()
    print(xpcall(function()
        print("xpcall-body", coroutine.isyieldable())
        coroutine.yield("protected")
        return "body"
    end, function(message) return message end))
    print(xpcall(function() error("bad", 0) end, function(message)
        print("xpcall-handler", coroutine.isyieldable())
        coroutine.yield("forbidden")
        return message
    end))
end)
print(resume(protected))
print(resume(protected))
