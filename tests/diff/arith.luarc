-- Arithmetic, precedence and in-range number printing (shared with Luau 0.743).
print(7 // 2, -7 // 2, 7 // -2, 7.5 // 2, -0.5 // 1)
print(7 % 3, -7 % 3, 7 % -3, -7 % -3, 5.5 % 2, -5.5 % 2)
print(2 ^ 10, 2 ^ -1, -2 ^ 2, (-2) ^ 2, 2 ^ 3 ^ 2)
print(1 + 2 * 3 - 4 / 2, (1 + 2) * 3, 10 - 4 - 3, 2 * 3 % 4)
print(1 / 0, -1 / 0, 0 / 0 ~= 0 / 0, math.huge, -math.huge)
print(-0, 0 * -1, 1 / (0 * -1), 0.1 + 0.2, 100 / 3)
print(1e15, 123456789012, 0x10, 0xff, 0b101, 1_000_000)
print(math.floor(-3.5), math.ceil(-3.5), math.floor(3), math.abs(-0), math.sqrt(16))
print(math.max(1, 5, 3), math.min(4, -2, 9))
print(5 // 0, -5 // 0, 5 % math.huge, -5 % math.huge, 5 % -math.huge)
print(3 == 3.0, 1 < 2, 2 <= 2, "a" < "b", "a" < "B", "" < "a", "abc" < "abd", "ab" < "abc")
print(10 - -2, - -3, -(-(4)), 2 - 3 - 4)
local x = 5
x += 1; print(x)
x -= 2; print(x)
x *= 3; print(x)
x /= 4; print(x)
x //= 1; print(x)
x %= 2; print(x)
x ^= 3; print(x)
local s = "a"
s ..= "b"; s ..= 1; print(s)
print(1 .. 2, 1.5 .. "", -0 .. "", 2 ^ 53 .. "")
print(tostring(12), tostring(-7.25), tostring(1e-3))
print(tonumber("12"), tonumber(" 0x1F "), tonumber("1e2"), tonumber("abc"), tonumber(""), tonumber("0x"), tonumber("5 5"))
print(tonumber("  -3.5  "), tonumber(".5"), tonumber("5."), tonumber("1e+2"))
