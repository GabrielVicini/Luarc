-- Local functions with unannotated parameters used at different types (each
-- call gets its own typed copy), calls with fewer arguments than parameters,
-- recursion, helpers that take functions, and `error(msg, level)` positions.

local function same(actual, expected, label)
    if actual ~= expected then
        error(string.format("%s: expected %s, got %s", label or "comparison", tostring(expected), tostring(actual)), 2)
    end
end

local function truthy(condition, label)
    if not condition then
        error(label or "assertion failed", 2)
    end
end

local function noop() end

-- never called: still accepted (an error level of 2 in unused code)
local function unused(condition)
    if not condition then
        error("never", 2)
    end
end

-- numbers, strings, booleans and nil through the same helper
same(1 + 1, 2)
same("a" .. "b", "ab")
same(not true, false)
same(nil, nil, "nils")
same(#"four", 4, "length")
truthy(true)
truthy(1)
truthy("text", "a string is true")
truthy({})
truthy(noop)
print("equal ok")

-- failures: level 2 reports the line of the call that failed
print(pcall(function()
    same(1, 2, "numbers")
end))
print(pcall(function() same("a", "b") end))
print(pcall(function() truthy(false) end))
print(pcall(function() truthy(nil, "custom") end))
print(pcall(function() same(true, false, "booleans") end))

-- level 0 has no position, level 1 (the default) is the error call itself
print(pcall(function() error("zero", 0) end))
print(pcall(function() error("one") end))
print(pcall(function() error("explicit one", 1) end))

-- the same function at several types
local function id(x)
    return x
end
print(id(1), id("s"), id(true), id(nil))
print(id(id(2)), id(id("t")))

-- recursion with a parameter of changing type per call site
local function rep(x, n)
    if n == 0 then
        return ""
    end
    return tostring(x) .. rep(x, n - 1)
end
print(rep(1, 3), rep("ab", 2), rep(true, 2))

-- fewer arguments than parameters: the rest is nil
local function opt(a, b)
    if b == nil then
        return tostring(a) .. "!"
    end
    return tostring(a) .. tostring(b)
end
print(opt(1), opt(1, 2), opt("x"), opt("x", "y"), opt(true, false))

-- an untyped `...` takes the types of its call; `...: any` takes mixed values
local function first(...)
    return (...)
end
print(first(1, 2), first("a", "b"), first(true))
local function count(...: any)
    return select("#", ...)
end
print(count(), count(1, "a", true), count(nil, nil))

-- helpers that take and call functions
local function twice(f, x)
    return f(f(x))
end
print(twice(function(n) return n + 1 end, 1))
print(twice(function(s) return s .. "!" end, "hi"))
print(twice(function(b) return not b end, true))

-- a helper that calls another helper
local function describe(value, label)
    same(value, value, label)
    return label .. "=" .. tostring(value)
end
print(describe(3, "n"), describe("s", "str"), describe(false, "flag"))

-- protected calls of functions given as parameters
local function attempt(name, fn)
    local ok, err = pcall(fn)
    if ok then
        print(name, "ok")
    else
        print(name, "failed", err)
    end
end
attempt("fine", function() end)
attempt("boom", function() error("bad", 0) end)
attempt("compare", function() same(1, 2) end)
