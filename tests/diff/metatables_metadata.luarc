local p = {x = 7, flag = true, zero = 5, negative = -9, empty = "parent", nan = 0/0, inf = math.huge}
local q = {x = 8}
local mt = {__index = p}
local alias = mt
local child = {x = 1, flag = false, zero = 0, empty = ""}
print("before", child.x)
print("identity", setmetatable(child, mt) == child)
print("own", child.x, child.flag, child.zero, child.empty == "")
child.x = nil
print("fallback", child.x, child["negative"], child.absent)
print("numbers", child.nan ~= child.nan, child.inf == math.huge)
alias["__index"] = q
print("replace", child.x)
alias.__index = nil
print("remove-index", child.x)
alias.__index = p
p.x = 9
print("live", child.x)
local replacement = {__index = q}
print("reattach", setmetatable(child, replacement) == child, child.x)
child.own = 3
local copy = table.clone(child)
print("clone", copy ~= child, copy.own, copy.x)
copy.own = 4
print("own-copy", child.own, copy.own)
replacement.__index = p
print("shared-meta", child.x, copy.x)
setmetatable(copy, {__index = q})
print("independent-attachment", child.x, copy.x)
q.x = 5
print("live-parent", child.x, copy.x)
local plain = {}
local plaincopy = table.clone(plain)
setmetatable(plain, mt)
print("unattached-clone", plain.x, plaincopy.x)
local function read(t): number? return t.x end
local unattached = {x = -3}
local captured = function() return read(copy) end
local array = {child, copy, unattached}
local map = {["item"] = child}
print("shared", read(unattached), read(array[2]), captured(), read(map["item"]))
local a, b = {x = 10}, {x = 20}
local metadata = {__index = a}
local target = {}
local function first() print("first") return target end
local function second() print("second") return metadata end
local function extra() print("extra") metadata.__index = b return 99 end
print("attach", setmetatable(first(), second(), extra()) == target, target.x)
local function old(self, n) print("old", self.x, n) return 1 end
local function new(self, n) print("new", self.x, n) return 2 end
a.f, b.f = old, new
metadata.__index = a
local function argument() print("argument") metadata.__index = b return 3 end
print("dot", target.f(target, argument()))
metadata.__index = a
print("colon", target:f(argument()))
metadata.__index = a
local function receiver() print("receiver") return target end
local function rhs() print("rhs") metadata.__index = b return 2 end
receiver().x += rhs()
print("compound", target.x, a.x, b.x)
target.x, a.x = a.x, target.x
print("parallel", target.x, a.x, b.x)
function a:fail() error("parent failure") end
metadata.__index = a
local ok, err = pcall(function() return target:fail() end)
print("failure", ok, err)
local ok2, err2 = pcall(function() local value = target:missing() return value end)
print("missing", ok2, err2)
