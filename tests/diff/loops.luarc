-- Numeric for (float/negative steps, fresh variable per iteration), ipairs, while, repeat.
local out = {}
for i = 1, 2, 0.5 do table.insert(out, i) end
print(table.concat(out, " "))
out = {}
for i = 10, 1, -3 do table.insert(out, i) end
print(table.concat(out, " "))
out = {}
for i = 1, 0 do table.insert(out, i) end
print(#out)
local strs = {}
for i = 0.1, 0.35, 0.1 do table.insert(strs, tostring(i)) end
print(table.concat(strs, " "))
local fns = {}
for i = 1, 3 do table.insert(fns, function() return i end) end
print(fns[1](), fns[2](), fns[3]())
for i = 1, 3 do
  local j = i
  i = i * 10
  table.insert(out, i + j)
end
print(table.concat(out, " "))
local arr = {1, 2, 3}
local seen = {}
for _, v in ipairs(arr) do
  table.insert(seen, v)
  if #arr < 5 then table.insert(arr, v * 10) end
end
print(table.concat(seen, ","))
local n = 0
while n < 5 do n += 1 if n == 3 then continue end end
print(n)
local k = 0
repeat local m = k k += 1 until m >= 3
print(k)
local total = 0
for i = 1, 10 do
  if i % 2 == 0 then continue end
  if i > 7 then break end
  total += i
end
print(total)
