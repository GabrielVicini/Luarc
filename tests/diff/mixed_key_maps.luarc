-- Mixed key tags share an identity-preserving map, with statically string values.
local t = {[1] = "number", ["1"] = "string", [false] = "boolean"}
print(t[1], t["1"], t[false])
t.label = "field"
print(t.label)
local zero: any = -0.0
t[zero] = "zero"
print(t[0])
local nilKey: any = nil
local nanKey: any = 0 / 0
print(t[nilKey], t[nanKey])
local ok, err = pcall(function() t[nanKey] = "nan" end)
print(ok, string.find(tostring(err), "table index is NaN", 1, true) ~= nil)
local a = {1}
local f = function() return 1 end
local objects: {[any]: string} = {[a] = "table", [f] = "function"}
print(objects[a], objects[f], objects[{1}])
local seen = 0
for k, v in t do
    if type(k) == "number" or type(k) == "string" or type(k) == "boolean" then seen += 1 end
    print(type(v))
end
print(seen)
