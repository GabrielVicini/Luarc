local flag = true
local ok, protected = pcall(function(): number? return nil end)
local conditional = flag and protected
print("conditional",conditional==nil,not conditional,conditional or "fallback",conditional and "rhs")
local t = {[0+1]="a",[1+1]="b",[2+1]="c"}; t[5]=nil
local success, next_key = pcall(function() return next(t,4) end)
print("next",success,next_key,next_key==nil,type(next_key))
local disabled = false
local false_conditional = disabled and protected
print('conditional-false',false_conditional==nil,not false_conditional,false_conditional or 'fallback',false_conditional and 'rhs')
local trace = ''
local function rhs() trace ..= 'r'; return 'rhs' end
local _, missing = pcall(function(): number? return nil end)
local _, zero = pcall(function(): number? return 0 end)
print('order-nil',missing and rhs(),trace)
print('order-or-nil',missing or rhs(),trace)
print('order-and-zero',zero and rhs(),trace)
print('order-or-zero',zero or rhs(),trace)
local _, integer_nil = pcall(function(): integer? return nil end)
local nil_alias = nil
print('integer-nil',integer_nil==nil,nil==integer_nil,integer_nil==nil_alias,nil_alias==integer_nil,not integer_nil,type(integer_nil))
if integer_nil then print('integer-branch','truthy') else print('integer-branch','falsey') end
local integer_ok, integer_some = pcall(function(): integer? return 0 end)
print('integer-some',integer_some==nil,nil==integer_some,integer_some~=nil,not integer_some,type(integer_some))
if integer_ok then print('integer-logic',integer_some or 7, integer_some and 8) end