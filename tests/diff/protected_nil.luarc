do
 local ok, key = pcall(function(): number? return nil end)
 print("nil-number", ok, key, key == nil, nil == key, key ~= nil, nil ~= key, type(key), not key)
 if key then print("branch", "truthy") else print("branch", "falsey") end
 print("logic", key or "fallback", key and "rhs")
 print("reverse",false or key,true and key,"lhs" or key,"lhs" and key,nil or key,nil and key)
 local nil_alias=nil; print("alias",key==nil_alias,nil_alias==key,key~=nil_alias,nil_alias~=key)
end
