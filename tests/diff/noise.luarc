-- math.noise: Luau's Perlin noise (single precision, fixed permutation table)
print(math.noise(0), math.noise(0.5), math.noise(1.5, 2.5), math.noise(0.1, 0.2, 0.3))
print(math.noise(-0.5), math.noise(-3.7, 4.2), math.noise(12.34, -56.78, 9.1))
print(math.noise(255.5, 256.5, 257.5), math.noise(1e6 + 0.5), math.floor(math.noise(-1e6 - 0.25, 7, 3) * 1e9))
print(math.noise(1, 2, 3), math.floor(math.noise(0.999999, 0, 0) * 1e9), math.noise(100.001))
local sum = 0
for i = 0, 400 do
    sum = sum + math.noise(i * 0.137, i * 0.071, i * 0.029)
end
print(sum)
print(math.noise(1e10, 1), math.noise(0/0), math.noise(math.huge))
