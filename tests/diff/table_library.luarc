local t={10,20,30,40,50}
print(table.move(t,1,4,2)==t,t[1],t[2],t[3],t[4],t[5])
table.move(t,2,5,1)
print(t[1],t[2],t[3],t[4],t[5])
local destination={}
print(table.move(t,1,2,-2,destination)==destination,destination[-2],destination[-1],destination[1])
local source={11,22,33}
source[2]=nil
local destination={1,2,3}
table.move(source,1,3,1,destination)
print(destination[1],destination[2],destination[3])
local result={}
table.move(t,'1.9','2.9','1.9',result)
print(result[1],result[2])
local frozen=table.freeze({4,5})
print(table.isfrozen(frozen),frozen[1],frozen[2])
local ok,err=pcall(function() frozen[1]=9 end)
print(ok,err)
local ok,err=pcall(function()table.freeze(frozen)end)
print(ok,err)
local ok,err=pcall(function()table.move(frozen,2,1,1)end)
print(ok,err)
local ok,err=pcall(function()table.move(frozen,1,1,1)end)
print(ok,err)
local ok,err=pcall(function()table.move(frozen,1,2,2147483647)end)
print(ok,err)
local ok,err=pcall(function()table.move(frozen,-2147483648,2147483647,1)end)
print(ok,err)
local list={10,20}
table.freeze({})
table.insert(list,1,30)
print(table.concat(list,',',1,3))
table.insert(list,0,40)
print(list[0],table.concat(list,',',1,3))
table.insert(list,5,50)
print(list[4],list[5])
local ok,err=pcall(function()table.concat(list,',',1,5)end)
print(ok,err)
local ok,err=pcall(function()table.insert(frozen,0,7)end)
print(ok,err)
